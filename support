    .contact-box {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 40px;
      text-align: center;
    }
    .contact-box h2 {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .contact-box p {
      color: #475569;
      font-size: 15px;
      margin-bottom: 16px;
    }
    .contact-box a.button {
      display: inline-block;
      background: #425ff0;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      padding: 12px 28px;
      border-radius: 10px;
      text-decoration: none;
    }
    .contact-box a.button:hover { background: #3451d1; }
    h2 {
      font-size: 17px;
      font-weight: 700;
      color: #0d101b;
      margin-top: 36px;
      margin-bottom: 10px;
    }
    .faq-item {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 12px;
    }
    .faq-item h3 {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 8px;
      color: #0d101b;
    }
    .faq-item p {
      font-size: 14px;
      color: #475569;
      margin: 0;
    }
    a { color: #425ff0; text-decoration: none; }
    a:hover { text-decoration: underline; }
    footer {
      text-align: center;
      padding: 32px 24px;
      font-size: 13px;
