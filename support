  <title>Support — Harvey</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f8fafc;
      color: #0d101b;
      line-height: 1.7;
    }
    header {
      background: #425ff0;
      padding: 24px 0;
      text-align: center;
    }
    header h1 {
      color: #fff;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }
    header p {
      color: rgba(255,255,255,0.7);
